{
  "catalog_id": "github_mcp",
  "connector": "github",
  "tools": [
    {
      "name": "github___whoami",
      "mutates": false,
      "description": "Authenticated user, orgs, scopes",
      "required": [],
      "properties": {}
    },
    {
      "name": "github___get_repository",
      "mutates": false,
      "description": "Repo metadata (default branch, visibility, topics)",
      "required": ["owner", "repo"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" }
      }
    },
    {
      "name": "github___get_file_contents",
      "mutates": false,
      "description": "Read a file or directory tree at a ref",
      "required": ["owner", "repo", "path"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "path": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    {
      "name": "github___list_commits",
      "mutates": false,
      "description": "Commit history for a branch/path",
      "required": ["owner", "repo"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "sha": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    {
      "name": "github___list_branches",
      "mutates": false,
      "description": "Branches on a repo",
      "required": ["owner", "repo"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" }
      }
    },
    {
      "name": "github___list_pull_requests",
      "mutates": false,
      "description": "Open/closed PRs, filterable by state and branch",
      "required": ["owner", "repo"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "state": { "type": "string", "enum": ["open", "closed", "all"] }
      }
    },
    {
      "name": "github___create_repository",
      "mutates": true,
      "type": "TYPE1",
      "description": "Create an org or personal repository",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "org": { "type": "string" },
        "private": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    {
      "name": "github___create_branch",
      "mutates": true,
      "type": "TYPE1",
      "description": "Create a branch from a base ref",
      "required": ["owner", "repo", "branch", "fromBranch"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "branch": { "type": "string" },
        "fromBranch": { "type": "string" }
      }
    },
    {
      "name": "github___push_files",
      "mutates": true,
      "type": "TYPE1",
      "description": "Push one or more files to a branch in a single commit",
      "required": ["owner", "repo", "branch", "files", "message"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "branch": { "type": "string" },
        "files": { "type": "array" },
        "message": { "type": "string" }
      }
    },
    {
      "name": "github___create_or_update_file",
      "mutates": true,
      "type": "TYPE1",
      "description": "Single-file create/update commit",
      "required": ["owner", "repo", "path", "content", "message", "branch"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "path": { "type": "string" },
        "content": { "type": "string" },
        "message": { "type": "string" },
        "branch": { "type": "string" },
        "sha": { "type": "string" }
      }
    },
    {
      "name": "github___create_pull_request",
      "mutates": true,
      "type": "TYPE1",
      "description": "Open a PR; body should carry the trail UUID",
      "required": ["owner", "repo", "title", "head", "base"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "title": { "type": "string" },
        "head": { "type": "string" },
        "base": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    {
      "name": "github___merge_pull_request",
      "mutates": true,
      "type": "TYPE1",
      "description": "Merge an approved PR",
      "required": ["owner", "repo", "pullNumber"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "pullNumber": { "type": "number" },
        "mergeMethod": { "type": "string", "enum": ["merge", "squash", "rebase"] }
      }
    }
  ]
}
